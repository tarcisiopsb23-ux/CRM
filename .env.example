# Opcional: Edge Functions (configurar no Supabase Dashboard → Edge Functions → Secrets)
# APP_URL: URL base do app (links de convite + CORS). Em produção, use o domínio real.
# APP_URL=http://localhost:8080

# C8 Control — URL base do CRM externo para redirecionamento pós-login
# O CRM_API_KEY é o secret compartilhado entre esta aplicação e o CRM externo
# (configurar também nos secrets das Edge Functions do Supabase)
VITE_C8_CONTROL_URL=https://crm.seudominio.com.br
# CRM_API_KEY=seu_secret_compartilhado_aqui

# n8n — URL base do servidor n8n (usado pelo proxy de dev e como referência)
VITE_N8N_BASE_URL=https://SEU-N8N.easypanel.host

# Recrutamento — ID da organização exibida na página pública vagas.agenciac8.com.br
# Obtenha em Supabase → tabela organizations → coluna id
VITE_PUBLIC_ORG_ID=5fb8e8ee-81a6-402b-ab7b-315d1cca6407

# Módulo Comercial — URL base para links públicos de propostas
# Formato: ${VITE_PROPOSAL_BASE_URL}/proposta/${slug}
VITE_PROPOSAL_BASE_URL=https://app.seudominio.com.br

# Módulo Agenda — n8n orquestrador central (agenda-upsert)
# URL do webhook n8n chamado ao criar/atualizar/cancelar agendamentos no C8 Control
VITE_N8N_AGENDA_WEBHOOK_URL=https://ia-n8n.whlwlh.easypanel.host/webhook/agenda-upsert
VITE_N8N_AGENDA_WEBHOOK_TOKEN=seu_token_aqui

# Google Calendar OAuth — URL base do Supabase (usada para construir redirect_uri)
# Já definida acima em VITE_SUPABASE_URL — reutilizada pelo useGoogleCalendar.ts

# ============================================================
# Variáveis do Frontend (prefixo VITE_ — expostas ao browser)
# ============================================================

# CRM Supabase — auth e dados no mesmo projeto (Banco de Testes)
VITE_SUPABASE_URL=https://<crm-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<crm-anon-key>

# ============================================================
# Secrets das Edge Functions
# Configurar em: Supabase Dashboard > Edge Functions > Secrets
# NUNCA colocar aqui — não vão para o frontend
# ============================================================

# CORS — domínio público do frontend (restringe origens aceitas pelas Edge Functions)
# APP_URL=https://seu-dominio.com

# Integração com Maestr.ia (comunicação entre sistemas)
# MAESTRIA_CRM_API_URL=https://<maestria-ref>.supabase.co/functions/v1/crm-tenant-api
# CRM_API_KEY=<uuid-secreto-compartilhado-com-maestria>

# Service role key do CRM (usada pelas Edge Functions para operações administrativas)
# SUPABASE_SERVICE_ROLE_KEY=<crm-service-role-key>  ← injetada automaticamente pelo Supabase

# JWT secret do CRM (usado pelas Edge Functions para verificar assinatura dos tokens)
# SUPABASE_JWT_SECRET=<crm-jwt-secret>  ← disponível em Settings > API > JWT Settings

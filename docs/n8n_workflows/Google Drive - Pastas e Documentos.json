      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = item.json.body || item.json;\nconst query = item.json.query || {};\nconst action = body.action || item.json.action || query.action || 'create';\nconst module = body.module || item.json.module || null;\nconst record = body.record || item.json.record || {};\nconst folderId = body.folderId || item.json.folderId || query.folderId || body.existing_folder_id || null;\nconst parentFolderId = body.parentFolderId || item.json.parentFolderId || folderId || null;\nconst newName = body.new_name || item.json.new_name || null;\nconst existingFolderId = body.existing_folder_id || item.json.existing_folder_id || folderId || null;\nconst rootFolderId = body.root_folder_id || item.json.root_folder_id || null;\nconst shareEmail = body.email || item.json.email || null;\nconst shareRole = body.role || item.json.role || 'reader';\nconst revokeEmail = body.email || item.json.email || null;\nconst fileId = body.fileId || item.json.fileId || null;\nconst binary = item.binary || {};\n\n// Nome base do registro\nconst baseName = body.name || item.json.name || body.subfolder || record.company || record.name || record.title || record.full_name || (module||'item') + '-' + (record.id||'novo');\n\n// Código numérico — formata como \"1 - Nome\" se disponível\nconst code = record.code != null ? record.code : null;\nconst folderName = code != null ? `${code} - ${baseName}` : baseName;\n\n// fileId tem prioridade — nunca deixa folderId sobrescrever quando é um arquivo\nconst resolvedId = fileId || folderId || rootFolderId || null;\nconst isFile = !!fileId;\n\nreturn [{ json: { action, module, record_id: record.id||null, nome: folderName, folderId, parentFolderId, existingFolderId, newName, rootFolderId, shareEmail, shareRole, revokeEmail, fileId, resolvedId, isFile }, binary }];\n"
      },

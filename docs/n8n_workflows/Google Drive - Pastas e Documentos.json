    {
      "parameters": {
        "jsCode": "const prep = $('Preparar Revogar').first().json;\nconst email = prep.email;\nconst folderId = prep.folderId;\n// Se permissionId já veio direto no payload, usa ele sem precisar buscar\nif (prep.permissionId) {\n  return [{ json: { folderId, permissionId: prep.permissionId, email } }];\n}\nconst permissions = $input.first().json.permissions || [];\nconst perm = permissions.find(p => p.emailAddress === email);\nif (!perm) throw new Error('Permissao nao encontrada para ' + email + ' na pasta ' + folderId);\nreturn [{ json: { folderId, permissionId: perm.id, email } }];"
      },

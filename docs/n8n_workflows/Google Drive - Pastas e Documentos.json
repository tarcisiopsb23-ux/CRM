      "parameters": {
        "jsCode": "const folder = $('Criar Pasta Raiz').first().json;\nconst norm = $('Normalizar Payload').first().json;\nif (!folder.id) return [{ json: { skip: true } }];\nconst tableMap = { client: 'clients', supplier: 'suppliers', project: 'projects', employee: 'profiles' };\nconst table = norm.module && tableMap[norm.module];\nreturn [{ json: { table, record_id: norm.record_id, folder_id: folder.id, folder_url: 'https://drive.google.com/drive/folders/' + folder.id } }];"
      },

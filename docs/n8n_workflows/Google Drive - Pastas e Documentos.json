        "responseBody": "={{ (() => { const norm = $('Normalizar Payload').first().json;\nconst action = norm.action;\nif (action === 'documents.folders.list') {\n  const items = $input.all().map(i => ({ id: i.json.id, name: i.json.name, mimeType: i.json.mimeType, url: i.json.webViewLink, modifiedTime: i.json.modifiedTime }));\n  return JSON.stringify({ folders: items });\n}\nif (action === 'documents.list') {\n  const items = $input.all().map(i => ({ id: i.json.id, name: i.json.name, mimeType: i.json.mimeType, url: i.json.webViewLink, modifiedTime: i.json.modifiedTime, size: i.json.size }));\n  return JSON.stringify({ files: items });\n}\nif (action === 'documents.folders.create') {\n  const f = $input.first().json;\n  return JSON.stringify({ id: f.id, name: f.name, url: f.webViewLink });\n}\nif (action === 'create') {\n  const f = $input.first().json;\n  return JSON.stringify({ success: true, folder_id: f.id || null, folder_url: f.id ? 'https://drive.google.com/drive/folders/' + f.id : null });\n}\nreturn JSON.stringify({ success: true }); })() }}",

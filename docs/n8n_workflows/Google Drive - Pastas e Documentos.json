      "parameters": {
        "jsCode": "const folderId = $input.first().json.id;\nconst norm = $('Normalizar Payload').first().json;\nconst module = norm.module;\nconst subs = { client: ['Contratos','Documentos','Relatorios','Comunicacoes','Notas Fiscais'], supplier: ['Contratos','Notas Fiscais','Documentos'], project: ['Briefing','Entregas','Aprovacoes','Arquivos','Notas Fiscais'], employee: ['Documentos Pessoais','Contratos','Avaliacoes', 'Atestados', 'Ocorrências', 'Outros'] };\nconst subfolders = (module && subs[module]) || [];\nreturn subfolders.map(name => ({ json: { parent_id: folderId, name, module, record_id: norm.record_id } }));"
      },

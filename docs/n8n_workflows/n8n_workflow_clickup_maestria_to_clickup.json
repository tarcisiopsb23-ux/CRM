{
  "name": "Maestr.ia → ClickUp (Terceirizados)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "maestria-to-clickup",
        "responseMode": "responseNode"
      },
      "id": "webhook-in",
      "name": "Webhook — Maestr.ia",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 400],
      "webhookId": "maestria-to-clickup"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst action = body.action;\nconst table  = body.table;\nconst item   = body.item;\n\nif (!item || !action || !table) {\n  return [{ json: { skip: true, reason: 'missing fields' } }];\n}\n\nconst statusMap = {\n  backlog: 'to do', em_andamento: 'in progress', em_revisao: 'in review',\n  concluida: 'complete', bloqueada: 'blocked', ativo: 'in progress',\n  parado: 'blocked', concluido: 'complete',\n};\nconst priorityMap = { urgente: 1, alta: 2, media: 3, baixa: 4 };\n\n// Para projetos: folder_id é onde a Lista será criada\n// Para tasks: clickup_list_id é a Lista onde a Task será criada\nconst folderIdForList = item.metadata?.clickup_folder_id || null;\nconst listIdForTask   = item.clickup_list_id || item.metadata?.clickup_list_id || item.parent_project?.clickup_list_id || null;\n\nreturn [{ json: {\n  action,\n  table,\n  item_id: item.id,\n  clickup_task_id: item.clickup_task_id || null,\n  clickup_list_id: item.clickup_list_id || null,\n  folder_id_for_list: folderIdForList,\n  list_id_for_task: listIdForTask,\n  title: item.title || item.name,\n  description: item.description || '',\n  status: statusMap[item.status] || 'to do',\n  priority: priorityMap[item.priority] || 3,\n  due_date: item.end_date ? new Date(item.end_date).getTime() : null,\n  start_date: item.start_date ? new Date(item.start_date).getTime() : null,\n  tags: ['terceirizado', table],\n  parent_project: item.parent_project || null\n}}];"
      },
      "id": "normalize",
      "name": "Normalizar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.skip }}", "value2": "true" }]
        }
      },
      "id": "skip-check",
      "name": "Verificar Skip",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "create", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true, "outputKey": "create"
            },
            {
              "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "update", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true, "outputKey": "update"
            },
            {
              "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "delete", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true, "outputKey": "delete"
            }
          ]
        }
      },
      "id": "route-action",
      "name": "Roteador de Ação",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [900, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": { "conditions": [{ "leftValue": "={{ $json.table }}", "rightValue": "projects", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true, "outputKey": "project"
            },
            {
              "conditions": { "conditions": [{ "leftValue": "={{ $json.table }}", "rightValue": "tasks", "operator": { "type": "string", "operation": "equals" } }] },
              "renameOutput": true, "outputKey": "task"
            }
          ]
        }
      },
      "id": "route-table-create",
      "name": "Projeto ou Tarefa? (criar)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [{ "value1": "={{ $json.clickup_task_id }}", "value2": "", "operation": "isNotEmpty" }]
        }
      },

        "jsonBody": "={{ JSON.stringify({ name: $json.title, content: $json.description, status: $json.status, due_date: $json.due_date, due_date_time: true, start_date: $json.start_date, start_date_time: true }) }}"
      },
      "id": "clickup-create-list",
      "name": "ClickUp — Criar Lista (Projeto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 0],

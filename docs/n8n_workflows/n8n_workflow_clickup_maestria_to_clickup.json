      "parameters": {
        "jsCode": "// Extrai o ID da task criada/atualizada e prepara para salvar no Maestr.ia\nconst result = $input.item.json;\nconst prev = $('Normalizar Payload').item.json;\n\nconst newId = result?.id || null;\nif (!newId) return [{ json: { skip: true, reason: 'no id returned' } }];\n\nreturn [{ json: {\n  parent_id: result.list.id,\n  parent_name: result.list.name,\n  table: prev.table,\n  item_id: prev.item_id,\n  clickup_task_id: newId\n}}];"
      },

    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst action = body.action;\nconst table  = body.table;\n\n// Suporta múltiplos formatos de entrada:\n// 1. body.item.task (novo formato do fireClickupWebhook)\n// 2. body.item diretamente (formato padrão)\n// 3. body.record (formato legado)\nconst rawItem = body.record || body.item;\nconst item = rawItem?.task || rawItem;\n\n// parent_project pode vir em body.item.parent_project ou body.item diretamente\nconst parentProject = body.item?.parent_project || body.parent_project || null;\n\nif (!item || !action || !table) {\n  return [{ json: { skip: true, reason: 'missing fields' } }];\n}\n\nconst statusMap = {\n  backlog: 'pendente', em_andamento: 'em andamento', em_revisao: 'em revisão',\n  concluida: 'concluida', parada: 'parada', ativo: 'em andamento',\n  parado: 'parado', concluido: 'concluido',\n};\nconst priorityMap = { urgente: 1, alta: 2, media: 3, baixa: 4 };\n\n// list_id para a task: vem do parent_project ou do item diretamente\nconst listIdForTask =\n  parentProject?.clickup_task_id ||\n  parentProject?.clickup_list_id ||\n  body.item?.clickup_list_id ||\n  item.clickup_list_id ||\n  item.metadata?.clickup_list_id ||\n  null;\n\nreturn [{ json: {\n  action,\n  table,\n  item_id: item.id,\n  clickup_task_id: item.clickup_task_id || null,\n  clickup_list_id: listIdForTask,\n  organization_id: item.organization_id,\n  project_id: item.project_id,\n  title: item.title || item.name,\n  description: item.description || '',\n  status: statusMap[item.status] || 'to do',\n  priority: priorityMap[item.priority] || 3,\n  estimated_hours: item.estimated_hours || null,\n  due_date: item.end_date ? new Date(item.end_date).getTime() : null,\n  start_date: item.start_date ? new Date(item.start_date).getTime() : null,\n  tags: ['terceirizado', table],\n  parent_project: parentProject\n}}];\n"
      },

    },
    {
      "parameters": {
        "url": "=https://api.clickup.com/api/v2/list/{{ $json.clickup_task_id }}",
        "requestMethod": "DELETE",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ $env.CLICKUP_API_KEY }}" }]
        }
      },
      "id": "clickup-delete-list",
      "name": "ClickUp — Excluir Lista (Projeto)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 640]
    },
    {
      "parameters": {
        "url": "=https://api.clickup.com/api/v2/task/{{ $json.clickup_task_id }}",
        "requestMethod": "DELETE",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "={{ $env.CLICKUP_API_KEY }}" }]
        }
      },
      "id": "clickup-delete-task",
      "name": "ClickUp — Excluir Task (Tarefa)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 760]
    },
    {
      "parameters": {
        "jsCode": "const created = $input.item.json;\nconst prev = $('Normalizar Payload').item.json;\n\n// Lista retorna { id }, Task retorna { id }\nconst newId = created?.id || null;\nif (!newId) return [{ json: { skip: true, reason: 'no id returned from ClickUp' } }];\n\nreturn [{ json: {\n  table: prev.table,\n  item_id: prev.item_id,\n  clickup_task_id: newId\n}}];"
      },
      "id": "extract-id",
      "name": "Extrair ID do ClickUp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 160]
    },
    {
      "parameters": {
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/set_clickup_task_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ p_table: $json.table, p_item_id: $json.item_id, p_clickup_id: $json.clickup_task_id }) }}"
      },
      "id": "save-id",
      "name": "Salvar ID no Maestr.ia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [2000, 160]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Normalizar Payload').item.json;\nconsole.log(`[skip] item_id=${prev.item_id} sem clickup_task_id`);\nreturn [{ json: { skipped: true } }];"
      },
      "id": "skip-no-id",
      "name": "Sem ID — Pular",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 860]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true }) }}"
      },
      "id": "respond",
      "name": "Resposta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2220, 400]
    }

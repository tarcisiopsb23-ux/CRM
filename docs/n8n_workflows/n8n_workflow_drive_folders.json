  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "_readme": {
    "description": "Workflow unificado para gerenciamento de pastas e documentos no Google Drive. O webhook 'drive-folder-manual' aceita GET e POST e roteia por 'action'.",
    "env_vars": [
      "DRIVE_FOLDER_CLIENTS   — ID da pasta raiz de Clientes no Google Drive",
      "DRIVE_FOLDER_SUPPLIERS — ID da pasta raiz de Fornecedores",
      "DRIVE_FOLDER_PROJECTS  — ID da pasta raiz de Projetos",
      "DRIVE_FOLDER_EMPLOYEES — ID da pasta raiz de Colaboradores",
      "DRIVE_FOLDER_ROOT      — Pasta raiz fallback",
      "SUPABASE_URL",
      "SUPABASE_SERVICE_KEY"
    ],
    "webhook_urls": {
      "client":   "{N8N_URL}/webhook/drive-folder-client",
      "supplier": "{N8N_URL}/webhook/drive-folder-supplier",
      "project":  "{N8N_URL}/webhook/drive-folder-project",
      "employee": "{N8N_URL}/webhook/drive-folder-employee",
      "manual":   "{N8N_URL}/webhook/drive-folder-manual"
    },
    "actions": {
      "documents.folders.list":   "GET/POST { action, folderId } → lista subpastas de uma pasta",
      "documents.list":           "GET/POST { action, folderId } → lista arquivos de uma pasta",
      "documents.folders.create": "POST { action, parentFolderId, name } → cria subpasta",
      "documents.upload":         "POST multipart { action, folderId, file } → faz upload de arquivo",
      "create":                   "POST { action, module, record: { id, name } } → cria pasta raiz do registro",
      "rename":                   "POST { action, existing_folder_id, new_name } → renomeia pasta",
      "delete":                   "POST { action, existing_folder_id } → exclui pasta",
      "create_subfolder":         "POST { action, existing_folder_id, subfolder } → cria subpasta manual"
    }
  }
}

        -80
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// ClickUp webhook payload\nconst body = $input.item.json;\nconst event = body.event; // 'taskStatusUpdated' | 'taskUpdated' | 'taskDeleted'\nconst task  = body.task_id;\nconst historyItems = body.history_items || [];\n\nif (!task) return [{ json: { skip: true, reason: 'no task_id' } }];\n\n// Map ClickUp status → Maestr.ia status\nconst statusMap = {\n  'to do': 'backlog',\n  'in progress': 'em_andamento',\n  'in review': 'em_revisao',\n  'complete': 'concluida',\n  'blocked': 'bloqueada',\n  'closed': 'concluida',\n};\n\nlet newStatus = null;\nfor (const h of historyItems) {\n  if (h.field === 'status' && h.after?.status) {\n    newStatus = statusMap[h.after.status.toLowerCase()] || null;\n  }\n}\n\n// Detecta exclusão\nconst isDelete = event === 'taskDeleted';\n\n// Pula se não é delete e não tem mudança de status\nif (!isDelete && !newStatus) {\n  return [{ json: { skip: true, reason: 'no status change' } }];\n}\n\nreturn [{ json: {\n  event,\n  clickup_task_id: task,\n  new_status: newStatus,\n  is_delete: isDelete,\n  skip: false\n}}];"
      },
      "id": "7bf3dd72-9806-49d3-ac1b-8d40dbe567d9",
      "name": "Parsear Evento ClickUp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1232,
        -80
      ],
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "// Usa $input para pegar os dados que chegam diretamente\n// Em vez de referenciar nós por nome (que pode mudar)\nconst input = $input.all();\n\n// Tenta pegar de ambos os nós por nome com fallback\nlet projects = [];\nlet tasks = [];\n\ntry { projects = $('Buscar Projetos com ClickUp ID').all().map(i => i.json); } catch(_) {}\ntry { tasks = $('Buscar Tasks com ClickUp ID').all().map(i => i.json); } catch(_) {}\n\n// Se não conseguiu pelos nomes, usa o input direto\nif (projects.length === 0 && tasks.length === 0) {\n  const all = input.map(i => i.json);\n  projects = all.filter(i => !i.project_id); // projetos não têm project_id\n  tasks = all.filter(i => i.project_id);\n}\n\nconst items = [\n  ...projects.map(p => ({ ...p, _table: 'projects' })),\n  ...tasks.map(t => ({ ...t, _table: 'tasks' }))\n];\n\nif (items.length === 0) {\n  return [{ json: { skip: true, reason: 'no items to sync' } }];\n}\n\nreturn items.map(item => ({ json: item }));\n"
      },
      "id": "bd57ba7c-4370-4124-9bc1-47bd3818f1f1",
      "name": "Combinar Itens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        1520
      ]
    },

        [{ "node": "Log Skip", "type": "main", "index": 0 }],
        [{ "node": "Atualizar Status no Maestr.ia", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },

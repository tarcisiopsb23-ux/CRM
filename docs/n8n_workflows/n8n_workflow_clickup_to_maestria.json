      "parameters": {
        "jsCode": "const projects = $('Buscar Projeto para Excluir').item.json;\nconst tasks    = $('Buscar Tarefa para Excluir').item.json;\nconst clickupId = $('Parsear Evento ClickUp').item.json.clickup_task_id;\n\nconst deletes = [];\n\nif (Array.isArray(projects) && projects.length > 0) {\n  deletes.push({ table: 'projects', id: projects[0].id });\n}\nif (Array.isArray(tasks) && tasks.length > 0) {\n  deletes.push({ table: 'tasks', id: tasks[0].id });\n}\n\nif (deletes.length === 0) {\n  console.log(`[delete] clickup_task_id=${clickupId} não encontrado em projects nem tasks — nada a excluir`);\n  return [{ json: { skip: true, reason: 'not found: ' + clickupId } }];\n}\n\nreturn deletes.map(d => ({ json: d }));"

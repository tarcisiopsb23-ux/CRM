    {
      "parameters": {
        "jsCode": "const projects = $('Buscar Projeto no Maestr.ia').item.json;\nconst tasks = $('Buscar Tarefa no Maestr.ia').item.json;\nconst newStatus = $('Parsear Evento ClickUp').item.json.new_status;\nconst clickupId = $('Parsear Evento ClickUp').item.json.clickup_task_id;\n\nconst updates = [];\n\nif (Array.isArray(projects) && projects.length > 0) {\n  updates.push({ table: 'projects', id: projects[0].id, status: newStatus });\n}\nif (Array.isArray(tasks) && tasks.length > 0) {\n  updates.push({ table: 'tasks', id: tasks[0].id, status: newStatus });\n}\n\nif (updates.length === 0) return [{ json: { skip: true, reason: 'not found: ' + clickupId } }];\n\nreturn updates.map(u => ({ json: u }));"
      },

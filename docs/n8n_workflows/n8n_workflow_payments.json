{
  "name": "Maestr.IA — Financeiro (Pagamentos)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payments",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-payments",
      "name": "Webhook Payments",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "payments-webhook"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{$json.body.event}}", "rightValue": "payment.received", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "received" },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.body.event}}", "rightValue": "payment.overdue", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "overdue" },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.body.event}}", "rightValue": "payment.created", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputKey": "created" }
          ]
        }
      },
      "id": "switch-payment",
      "name": "Switch Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fromEmail": "financeiro@suaagencia.com",
        "toEmail": "financeiro@suaagencia.com",
        "subject": "=✅ Pagamento Recebido — {{$json.body.payment.description}}",
        "emailType": "html",
        "message": "=<h2>Pagamento Confirmado</h2><p><strong>Descrição:</strong> {{$json.body.payment.description}}</p><p><strong>Valor:</strong> R$ {{$json.body.payment.value}}</p><p><strong>Recebido em:</strong> {{$json.body.payment.paid_at}}</p>"
      },
      "id": "email-received",
      "name": "Email Recebido",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 160],
      "credentials": { "smtp": { "id": "SMTP_CRED_ID", "name": "SMTP" } }
    },
    {
      "parameters": {
        "fromEmail": "financeiro@suaagencia.com",
        "toEmail": "financeiro@suaagencia.com",
        "subject": "=⚠️ Pagamento Vencido — {{$json.body.payment.description}}",
        "emailType": "html",
        "message": "=<h2>Pagamento em Atraso</h2><p><strong>Descrição:</strong> {{$json.body.payment.description}}</p><p><strong>Valor:</strong> R$ {{$json.body.payment.value}}</p><p><strong>Vencimento:</strong> {{$json.body.payment.due_date}}</p>"
      },
      "id": "email-overdue",
      "name": "Email Vencido",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 300],
      "credentials": { "smtp": { "id": "SMTP_CRED_ID", "name": "SMTP" } }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"received\": true}"
      },
      "id": "respond-payments",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [940, 300]
    }
  ],
  "connections": {
    "Webhook Payments": { "main": [[{ "node": "Switch Event", "type": "main", "index": 0 }]] },
    "Switch Event": {
      "main": [
        [{ "node": "Email Recebido", "type": "main", "index": 0 }],
        [{ "node": "Email Vencido", "type": "main", "index": 0 }],
        [{ "node": "Respond", "type": "main", "index": 0 }]
      ]
    },
    "Email Recebido": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] },
    "Email Vencido": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0"
}

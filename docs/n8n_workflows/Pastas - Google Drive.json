        "jsCode": "const norm = $('Normalizar Payload').first().json;\n// Usa folderId com fallback para existingFolderId\nconst folderId = norm.folderId || norm.existingFolderId || null;\nconst email = norm.revokeEmail;\nconst permissionId = norm.permissionId || null;\nif (!folderId) throw new Error('folderId nao informado para revogar acesso');\nreturn [{ json: { folderId, email, permissionId } }];"

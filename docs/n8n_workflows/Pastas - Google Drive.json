      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = item.json.body || item.json;\nconst query = item.json.query || {};\nconst action = body.action || item.json.action || query.action || 'create';\nconst module = body.module || item.json.module || null;\nconst record = body.record || item.json.record || {};\nconst folderId = body.folderId || item.json.folderId || query.folderId || body.existing_folder_id || null;\nconst parentFolderId = body.parentFolderId || item.json.parentFolderId || folderId || null;\nconst folderName = body.name || item.json.name || body.subfolder || record.company || record.name || record.title || record.full_name || (module||'item')+'-'+(record.id||'novo');\nconst newName = body.new_name || item.json.new_name || null;\nconst existingFolderId = body.existing_folder_id || item.json.existing_folder_id || folderId || null;\nconst rootFolderId = body.root_folder_id || item.json.root_folder_id || null;\nconst shareEmail = body.email || item.json.email || null;\nconst shareRole = body.role || item.json.role || 'reader';\nconst revokeEmail = body.email || item.json.email || null;\nconst fileId = body.fileId || item.json.fileId || null;\nconst permissionId = body.permissionId || item.json.permissionId || null;\nconst binary = item.binary || {};\nreturn [{ json: { action, module, record_id: record.id||null, nome: folderName, folderId, parentFolderId, existingFolderId, newName, rootFolderId, shareEmail, shareRole, revokeEmail, fileId, permissionId }, binary }];"
      },

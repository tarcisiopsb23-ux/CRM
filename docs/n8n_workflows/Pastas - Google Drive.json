        "options": {}
      },
      "id": "revogar-acesso",
      "name": "Revogar Acesso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1520,
        1760
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "diPzs7TWD1Fa5lUn",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ (() => {\n  const norm = $('Normalizar Payload').first().json;\n  const action = norm.action;\n\n  if (action === 'documents.folders.list') {\n    // Google Drive API returns { files: [...] } — extract and return as folders\n    const raw = $input.first().json;\n    const items = (raw.files || raw.folders || (Array.isArray(raw) ? raw : [])).map(i => ({\n      id: i.id, name: i.name, mimeType: i.mimeType, url: i.webViewLink, modifiedTime: i.modifiedTime\n    }));\n    return JSON.stringify({ folders: items });\n  }\n\n  if (action === 'documents.list') {\n    const raw = $input.first().json;\n    const items = (raw.files || (Array.isArray(raw) ? raw : [])).map(i => ({\n      id: i.id, name: i.name, mimeType: i.mimeType, url: i.webViewLink, modifiedTime: i.modifiedTime, size: i.size\n    }));\n    return JSON.stringify({ files: items });\n  }\n\n  if (action === 'documents.folders.create') {\n    const f = $input.first().json;\n    return JSON.stringify({ id: f.id, name: f.name, url: f.webViewLink });\n  }\n\n  if (action === 'create') {\n    const f = $input.first().json;\n    return JSON.stringify({ success: true, folder_id: f.id || null, folder_url: f.id ? 'https://drive.google.com/drive/folders/' + f.id : null });\n  }\n\n  return JSON.stringify({ success: true });\n})() }}",
        "options": {}
      },

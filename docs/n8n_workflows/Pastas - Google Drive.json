          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Preparar Revogar').first().json;\nconst email = prep.email;\nconst folderId = prep.folderId;\n// Se permissionId já veio direto no payload, usa ele sem precisar buscar\nif (prep.permissionId) {\n  return [{ json: { folderId, permissionId: prep.permissionId, email } }];\n}\nconst permissions = $input.first().json.permissions || [];\nconst perm = permissions.find(p => p.emailAddress === email);\nif (!perm) throw new Error('Permissao nao encontrada para ' + email + ' na pasta ' + folderId);\nreturn [{ json: { folderId, permissionId: perm.id, email } }];"
      },
      "id": "encontrar-permissao",
      "name": "Encontrar Permissao",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        1680
      ]
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Preparar Revogar').first().json;\nreturn [{ json: { folderId: prep.folderId, permissionId: prep.permissionId, email: prep.email } }];"
      },
      "id": "usar-permission-id-direto",
      "name": "Usar permissionId Direto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        1840
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://www.googleapis.com/drive/v3/files/{{ $json.folderId }}/permissions/{{ $json.permissionId }}",
        "authentication": "predefinedCredentialType",
